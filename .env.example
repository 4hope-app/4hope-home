# Analytics — set ONE of these (leave both empty to disable analytics).
# Read on the server when pages render, so set them before `npm run build` / deploy.
# Plausible: the domain registered in Plausible, e.g. 4hope.app
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Umami: the website ID and script URL from your Umami instance
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# ---------------------------------------------------------------------------
# Auth.js (next-auth v5) — Google sign-in. Server-only: never prefix with NEXT_PUBLIC_.
AUTH_SECRET=            # generate with `npx auth secret`
AUTH_GOOGLE_ID=         # OAuth Client ID (type "Web application") in Google Cloud Console
AUTH_GOOGLE_SECRET=
# Authorized redirect URI in that OAuth client: <origin>/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google and https://4hope.app/api/auth/callback/google
# Needed outside Vercel (Cloudflare, `next start`): trust the Host header the platform sets.
AUTH_TRUST_HOST=true

# Firebase Admin (Firestore) — service account, server-only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="" # as in the service-account JSON, one line with \n
# "production" | "uat"; outside production the collections get a "-uat" suffix (users-uat).
APP_ENV=uat
