# Analytics — set ONE of these (leave both empty to disable analytics).
# Read on the server when pages render, so set them before `npm run build` / deploy.
# Plausible: the domain registered in Plausible, e.g. 4hope.app
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Umami: the website ID and script URL from your Umami instance
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# ---------------------------------------------------------------------------
# Auth.js (next-auth v5) — Google sign-in. Server-only: never prefix with NEXT_PUBLIC_.
AUTH_SECRET=            # generate with `npx auth secret`
AUTH_GOOGLE_ID=         # OAuth Client ID (type "Web application") in Google Cloud Console
AUTH_GOOGLE_SECRET=
# Authorized redirect URI in that OAuth client: <origin>/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google and https://4hope.app/api/auth/callback/google
# Needed outside Vercel (Cloudflare, `next start`): trust the Host header the platform sets.
AUTH_TRUST_HOST=true

# Firebase Admin (Firestore) — service account, server-only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="" # as in the service-account JSON, one line with \n
# "production" | "uat"; outside production the collections get a "-uat" suffix (users-uat).
APP_ENV=uat

# Riot Games API (developer.riotgames.com) — server-only, used to link a Riot ID on /profile.
# Development keys expire every 24 h; links made while the key is rejected are saved unverified
# and retried on the next profile visit. Cloudflare: `wrangler secret put RIOT_API_KEY`.
RIOT_API_KEY=
# Minimum seconds between manual rank refreshes of a linked account (default 180).
RIOT_REFRESH_COOLDOWN_SECONDS=180
# Riot Sign-On (RSO) client — players link their Riot account by signing in to Riot, which proves
# they own it. Riot only issues RSO clients to apps with an approved production key; until these
# are set the "Connect with Riot" button is disabled. Redirect URI to register with Riot:
#   <origin>/api/profile/riot/callback   e.g. https://4hope.app/api/profile/riot/callback
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
