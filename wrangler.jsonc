{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4hope-home",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Keep the text variables set in the Cloudflare dashboard (e.g. APP_ENV). Without this,
  // every `wrangler deploy` / `versions upload` (Workers Builds runs one on each push) treats
  // this file as the full list of vars and deletes any dashboard var not declared below.
  // Secrets (AUTH_*, FIREBASE_*, RIOT_*) are never touched either way.
  "keep_vars": true,
  // Plain (non-secret) runtime vars every version needs. Auth.js needs this outside Vercel or it
  // fails with UntrustedHost.
  "vars": {
    "AUTH_TRUST_HOST": "true",
  },
}
