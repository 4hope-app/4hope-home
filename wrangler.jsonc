{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4hope-home",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Plain (non-secret) runtime vars. Declared here because `wrangler deploy` / `versions upload`
  // drop text variables added in the dashboard; secrets (AUTH_*, FIREBASE_*, RIOT_*, APP_ENV)
  // stay in the dashboard. Auth.js needs this outside Vercel or it fails with UntrustedHost.
  "vars": {
    "AUTH_TRUST_HOST": "true",
  },
}
