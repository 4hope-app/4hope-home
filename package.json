{
  "name": "4hope-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Official landing page for 4HOPE (4hope.app) — tools for the LATAM TFT community.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "tokens": "node --experimental-strip-types --no-warnings scripts/build-tokens.ts",
    "dev": "npm run tokens && next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:build": "npm run tokens && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
